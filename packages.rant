# The GitHub repos rant install looks in. The name in the package.rant at the root of each
# repo names its package, and no two may name the same.

repos = [
  "KosmosisDire/rant-cli",
  "KosmosisDire/rant-bridge",
  "KosmosisDire/rant-explorer",
  "KosmosisDire/rant-vscode",
  "KosmosisDire/rant-transcoder",
  "KosmosisDire/rant-hmi",
  "KosmosisDire/rant-manager",
]
