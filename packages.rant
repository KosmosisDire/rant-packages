# The GitHub repos rant install and rant add look in. The name in the package.rant at the root
# of each repo names its package or library, and no two may name the same.

repos = [
  "KosmosisDire/Rant",
  "KosmosisDire/rant-math",
  "KosmosisDire/rant-bridge",
  "KosmosisDire/rant-explorer",
  "KosmosisDire/rant-vscode",
  "KosmosisDire/rant-transcoder",
  "KosmosisDire/rant-hmi",
  "KosmosisDire/rant-manager",
]
